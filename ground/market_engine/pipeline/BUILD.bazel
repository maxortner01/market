load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "pipeline",
    srcs = ["pipeline.cpp"],
    hdrs = ["pipeline.h"],
    include_prefix = "ground/market_engine/pipeline",
    strip_include_prefix = "",
    visibility = ["//visibility:public"],
    deps = [
        "//ground/market_engine/adapt:adapt",
        "//ground/market_engine/analysis:analysis",
        "//ground/market_engine/core:core",
        "//ground/market_engine/export:export",
        "//ground/market_engine/fetcher:fetcher",
        "//ground/market_engine/risk:risk",
        "//ground/util:util",
    ],
)

cc_test(
    name = "pipeline_test",
    srcs = ["pipeline_test.cpp"],
    deps = [
        ":pipeline",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "pipeline_bench",
    testonly = True,
    srcs = ["pipeline_bench.cpp"],
    deps = [
        ":pipeline",
        "@google_benchmark//:benchmark_main",
    ],
)
