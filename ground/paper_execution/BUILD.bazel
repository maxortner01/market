    deps = [
        ":paper_executor",
        "//ground/util:util",
    ],
)

cc_test(
    name = "paper_executor_test",
    srcs = ["paper_executor_test.cpp"],
    deps = [
        ":paper_executor",
        "@googletest//:gtest_main",
    ],
)
