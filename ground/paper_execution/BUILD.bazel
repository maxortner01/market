load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "paper_executor",
    srcs = ["paper_executor.cpp"],
    hdrs = ["paper_executor.h"],
    include_prefix = "ground/paper_execution",
    strip_include_prefix = "",
    visibility = ["//visibility:public"],
    deps = [
        "//ground/market_engine/core:core",
        "//ground/market_engine/export:export",
